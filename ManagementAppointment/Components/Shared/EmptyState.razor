<div class="empty-state"><span class="empty-icon"><Icon Name="@Icon" Size="30" /></span><h3>@Title</h3><p>@Description</p>@ChildContent</div>
@code {
    [Parameter] public string Icon { get; set; } = "calendar";
    [Parameter] public string Title { get; set; } = "Todo listo para comenzar";
    [Parameter] public string Description { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
