@if (!string.IsNullOrEmpty(Message)) { <div class="notice @Kind" role="@(Kind == "error" ? "alert" : "status")"><Icon Name="@(Kind == "error" ? "shield" : "check")" /><span>@Message</span></div> }
@code { [Parameter] public string? Message { get; set; } [Parameter] public string Kind { get; set; } = "success"; }
