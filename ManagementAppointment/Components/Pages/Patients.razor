@page "/pacientes"
@attribute [Authorize(Roles = Roles.Staff)]
@rendermode InteractiveServer
@inherits ClinicPageBase
<PageTitle>Pacientes de la oficina · ManagementAppointment</PageTitle>
<div class="page-heading"><div><span class="eyebrow">GESTIÓN DE MI CONSULTA</span><h1>Mis pacientes</h1><p>Perfiles registrados, próximas citas y pacientes disponibles para adelantar su atención.</p></div><button class="button primary" @onclick="New"><Icon Name="plus" />Registrar paciente</button></div>
<Notice Kind="error" Message="@Error" /><Notice Message="@Success" />
<div class="stats-grid"><section class="stat-card"><span class="stat-icon"><Icon Name="users" /></span><div><span class="stat-label">Pacientes registrados</span><strong class="stat-number">@items.Count</strong></div></section><section class="stat-card"><span class="stat-icon blue"><Icon Name="calendar" /></span><div><span class="stat-label">Con cita programada</span><strong class="stat-number">@items.Count(x => Next(x.Id) != null)</strong></div></section><section class="stat-card"><span class="stat-icon amber"><Icon Name="clock" /></span><div><span class="stat-label">En hold / disponibles</span><strong class="stat-number">@hold.Select(x => x.PatientId).Distinct().Count()</strong></div></section></div>
@if (items.Any(x => x.IsDemo)) { <Notice Kind="info" Message="Los perfiles DEMO son ficticios. Direcciones, teléfonos y correos son datos de demostración; no se envían mensajes a estos contactos." /> }
<section class="card"><div class="filter-bar"><div class="filter-field wide"><label for="patients-search">Buscar paciente</label><input id="patients-search" @bind="search" @bind:event="oninput" @bind:after="ResetPage" placeholder="Nombre, código, municipio o teléfono" /></div><button class="button secondary" @onclick="Reload" disabled="@Busy">Actualizar</button></div>
@if (Loading) { <p class="loading" role="status">Cargando pacientes…</p> }
else if (!Filtered.Any()) { <EmptyState Icon="users" Title="No hay pacientes para mostrar" Description="El médico y su personal registran los pacientes desde esta pantalla." /> }
else { <div class="table-scroll"><table class="clinic-table"><thead><tr><th>Paciente</th><th>Municipio / contacto</th><th>Próxima cita</th><th>Disponibilidad</th><th>Gestión</th></tr></thead><tbody>
@foreach (var p in Filtered.Skip((page - 1) * 10).Take(10)) { var next = Next(p.Id); <tr><td><div class="person-cell"><span class="avatar soft">@AppointmentTable.Initials(p.FullName)</span><span><strong>@p.FullName</strong><small>@p.DocumentNumber @(p.IsDemo ? "· DEMO" : "")</small></span></div></td><td>@p.Municipality<small>@p.Phone</small></td><td>@if (next != null) { <button class="table-action" @onclick="@(() => selectedAppointment = next)">@Clock.Local(next.StartUtc).ToString("dd MMM · h.mm tt")</button><small>@StatusText.Label(next.Status)</small> } else { <span class="muted">Sin cita</span> }</td><td><span class="status-pill @(hold.Any(x => x.PatientId == p.Id) ? "pending" : "confirmed")">@(hold.Any(x => x.PatientId == p.Id) ? "En hold" : "Sin hold activo")</span></td><td><div class="heading-actions"><button class="table-action" @onclick="@(() => Profile(p))">Perfil</button><button class="table-action" @onclick="@(() => bookingPatient = p.Id)">Programar</button><a class="table-action" href="@($"/lista-espera?paciente={p.Id}")">Hold</a>@if (actor?.IsStaff == true || p.RegisteredByDoctorId == actor?.DoctorId) { <button class="table-action" @onclick="@(() => Edit(p))">Editar</button> }</div></td></tr> }
</tbody></table></div><div class="pagination-bar"><span>@Filtered.Count() pacientes</span><div><button class="button small secondary" disabled="@(page == 1)" @onclick="@(() => page--)">Anterior</button><span>Página @(page)</span><button class="button small secondary" disabled="@(page * 10 >= Filtered.Count())" @onclick="@(() => page++)">Siguiente</button></div></div> }
</section>
@if (editing) { <Modal Title="@(form.Id == 0 ? "Registrar paciente" : "Editar perfil")" OnClose="@(() => editing = false)"><Notice Kind="error" Message="@Error" /><EditForm Model="form" OnValidSubmit="Save"><DataAnnotationsValidator /><ValidationSummary /><label for="patient-name">Nombre completo</label><InputText id="patient-name" @bind-Value="form.FullName" maxlength="120" /><div class="form-grid"><div><label for="patient-doc">Código o documento</label><InputText id="patient-doc" @bind-Value="form.DocumentNumber" maxlength="40" /></div><div><label for="patient-birth">Fecha de nacimiento</label><InputDate id="patient-birth" @bind-Value="form.BirthDate" max="@Clock.Today.ToString("yyyy-MM-dd")" /></div><div><label for="patient-email">Correo para avisos</label><InputText id="patient-email" type="email" @bind-Value="form.Email" maxlength="254" /></div><div><label for="patient-phone">Teléfono</label><InputText id="patient-phone" type="tel" @bind-Value="form.Phone" maxlength="30" /></div></div><label for="patient-address">Dirección</label><InputText id="patient-address" @bind-Value="form.Address" maxlength="200" /><div class="form-grid"><div><label for="patient-town">Municipio</label><InputText id="patient-town" @bind-Value="form.Municipality" maxlength="80" /></div><div><label for="patient-postal">Código postal</label><InputText id="patient-postal" @bind-Value="form.PostalCode" maxlength="12" /></div></div><label class="checkbox-label"><InputCheckbox @bind-Value="form.ContactConsent" />Autorización de contacto por correo registrada por la oficina</label><label class="checkbox-label"><InputCheckbox @bind-Value="form.AutomaticReassignmentConsent" />El paciente autoriza asignaciones y adelantos automáticos dentro de su disponibilidad</label><p class="field-help">Perfil interno: no habilita acceso del paciente a la web.</p><div class="form-footer"><button class="button secondary" type="button" @onclick="@(() => editing = false)">Volver</button><button class="button primary" type="submit" disabled="@Busy">Guardar perfil</button></div></EditForm></Modal> }
@if (profile != null) { <Modal Title="@profile.FullName" OnClose="@(() => profile = null)"><span class="status-pill confirmed">@(profile.IsDemo ? "Perfil ficticio · DEMO" : "Perfil interno de la oficina")</span><div class="detail-meta"><p><strong>Código:</strong> @profile.DocumentNumber</p><p><strong>Nacimiento:</strong> @(profile.BirthDate?.ToString("dd MMM yyyy") ?? "Sin registrar")</p><p><strong>Correo:</strong> @profile.Email</p><p><strong>Teléfono:</strong> @profile.Phone</p><p><strong>Dirección:</strong> @profile.Address, @profile.Municipality, Puerto Rico @profile.PostalCode</p></div><p class="field-help">Sin acceso web para pacientes. Las contraseñas de demostración están protegidas; el archivo privado del modelo contiene sus valores iniciales.</p><h4 class="section-label">Citas del paciente</h4>@if (history.Count == 0) { <p class="muted">Sin citas registradas.</p> } else { @foreach (var item in history) { <div class="schedule-item"><span><strong>@Clock.Local(item.StartUtc).ToString("dd MMM yyyy · h.mm tt")</strong><small>@item.Doctor.FullName</small></span><span class="status-pill @StatusText.Css(item.Status)">@StatusText.Label(item.Status)</span></div> } }</Modal> }
@if (bookingPatient != 0) { <Modal Title="Programar cita del paciente" OnClose="@(() => bookingPatient = 0)"><AppointmentEditor PatientId="bookingPatient" DoctorId="@(actor?.DoctorId ?? 0)" OnSaved="Changed" OnCancel="@(() => bookingPatient = 0)" /></Modal> }
@if (selectedAppointment != null) { <Modal Title="Gestión de la cita" OnClose="@(() => selectedAppointment = null)"><AppointmentDetail Item="selectedAppointment" OnChanged="Changed" /></Modal> }
@code {
    private ClinicActor? actor;
    private List<Patient> items = [];
    private List<Appointment> history = [], upcoming = [];
    private List<WaitlistEntry> hold = [];
    private PatientForm form = new();
    private Patient? profile;
    private Appointment? selectedAppointment;
    private string search = "";
    private bool editing;
    private int page = 1, bookingPatient;
    private void ResetPage() => page = 1;
    private Appointment? Next(int id) => upcoming.FirstOrDefault(x => x.PatientId == id);
    private IEnumerable<Patient> Filtered => items.Where(x => (x.FullName + " " + x.DocumentNumber + " " + x.Municipality + " " + x.Email + " " + x.Phone).Contains(search, StringComparison.OrdinalIgnoreCase));
    protected override Task OnInitializedAsync() => Reload();
    private async Task Load() { actor = await Clinic.ActorAsync(); items = await Clinic.PatientsAsync(); upcoming = (await Clinic.AppointmentsAsync(Clock.Today, Clock.Today.AddDays(180))).Where(x => x.StartUtc > DateTime.UtcNow && x.Status is AppointmentStatus.Pending or AppointmentStatus.Confirmed).ToList(); hold = (await Clinic.WaitlistAsync()).Where(x => x.Status == WaitlistStatus.Active).ToList(); page = 1; }
    private Task Reload() => Run(Load);
    private void New() { form = new(); editing = true; Error = null; }
    private void Edit(Patient p) { form = new() { Id = p.Id, FullName = p.FullName, DocumentNumber = p.DocumentNumber, BirthDate = p.BirthDate, Email = p.Email, Phone = p.Phone, Address = p.Address, Municipality = p.Municipality, PostalCode = p.PostalCode, ContactConsent = p.ContactConsent, AutomaticReassignmentConsent = p.AutomaticReassignmentConsent }; editing = true; Error = null; }
    private Task Save() => Run(async () => { await Clinic.SavePatientAsync(form); editing = false; await Load(); }, "Perfil guardado.");
    private Task Profile(Patient p) => Run(async () => { history = await Clinic.PatientHistoryAsync(p.Id); profile = p; });
    private async Task Changed() { bookingPatient = 0; selectedAppointment = null; await Reload(); }
}

